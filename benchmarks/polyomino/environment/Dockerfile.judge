FROM --platform=linux/amd64 yanagiorigami/frontier-cs-harbor-judge@sha256:c1536d4b937267f88ddf31aae1db9e551522fff0c597af842b422f03904d0de8 AS original
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl g++ python3 \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Match the original image's sandbox, using a native executable.
RUN set -eu; \
    case "$(uname -m)" in \
      x86_64) judge_arch=amd64v2 ;; \
      aarch64) judge_arch=arm64 ;; \
      *) exit 1 ;; \
    esac; \
    asset="go-judge_1.11.4_linux_${judge_arch}.tar.gz"; \
    url="https://github.com/criyle/go-judge/releases/download/v1.11.4"; \
    mkdir /tmp/go-judge && cd /tmp/go-judge; \
    curl -fsSL "$url/$asset" -o "$asset"; \
    curl -fsSL "$url/checksums.txt" -o checksums.txt; \
    awk -v asset="$asset" '$2 == asset { print }' checksums.txt > selected-checksum.txt; \
    test -s selected-checksum.txt && sha256sum -c selected-checksum.txt; \
    tar -xzf "$asset" -C /usr/local/bin go-judge; \
    chmod +x /usr/local/bin/go-judge; \
    rm -rf /tmp/go-judge

COPY --from=original /app/ /app/
COPY --from=original /lib/testlib/ /lib/testlib/
WORKDIR /app
ENV PORT=8081 GJ_ADDR=http://127.0.0.1:5050
ENTRYPOINT ["/app/entrypoint.sh"]
